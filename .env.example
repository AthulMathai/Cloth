# Public (shipped to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only (Netlify Functions). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Integrations — 'mock' uses the clearly-labelled development adapters
INTEGRATIONS_MODE=mock
PAYMENT_PROVIDER=mock          # stripe later
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_PROVIDER=mock
MODERATION_PROVIDER=mock
SHIPPING_PROVIDER=mock
EMAIL_PROVIDER=mock
